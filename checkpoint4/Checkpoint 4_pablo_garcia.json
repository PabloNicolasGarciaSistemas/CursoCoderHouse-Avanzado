              "value": "={{ (() => { let o = $json.output; if (typeof o === 'string') { try { o = JSON.parse(o.replace(/```json|```/g, '').trim()); } catch (e) { o = { categoria: 'OTRO', prioridad: 'MEDIA', resumen: 'No se pudo interpretar la respuesta de la IA', borrador: String($json.output || '') }; } } return o; })() }}",
              "type": "object"
            }
          ]
        },
